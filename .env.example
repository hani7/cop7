DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MYSQL_DATABASE=copet
# Local MySQL in .runtime. Use the generated password in your existing .env.
MYSQL_USER=copet_app
MYSQL_PASSWORD=replace-with-the-local-database-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
APP_CURRENCY=DZD
APP_TIME_ZONE=Africa/Lagos
